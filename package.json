    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "STANDARD.md",
    "RUBRIC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
